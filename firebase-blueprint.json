{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfis de usuários, cargos e permissões administrativas",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "moderador", "editor", "leitor", "convidado"] },
        "isBanned": { "type": "boolean" },
        "banReason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "WikiCollection": {
      "title": "WikiCollection",
      "description": "Coleções e tópicos temáticos da enciclopédia",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "titulo": { "type": "string" },
        "descricao": { "type": "string" },
        "categoria": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["uid", "titulo"]
    },
    "WikiArticle": {
      "title": "WikiArticle",
      "description": "Artigos em formato wikitext e metadados",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pageUid": { "type": "string" },
        "titulo": { "type": "string" },
        "descricao": { "type": "string" },
        "autor": { "type": "string" },
        "categoria": { "type": "string" }
      },
      "required": ["id", "pageUid", "titulo"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Documentos de usuários e permissões"
    },
    "/documentos/{pageUid}": {
      "schema": "WikiCollection",
      "description": "Coleções de tópicos"
    },
    "/documentos/{pageUid}/inevitavel/{articleId}": {
      "schema": "WikiArticle",
      "description": "Artigos da enciclopédia"
    },
    "/banned_users/{userId}": {
      "schema": "UserProfile",
      "description": "Lista de usuários banidos"
    },
    "/audit_logs/{logId}": {
      "schema": "object",
      "description": "Registros de auditoria administrativa"
    }
  }
}
