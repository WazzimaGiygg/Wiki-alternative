{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfis de usuários, cargos e permissões administrativas",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "moderador", "editor", "leitor", "convidado"] },
        "isBanned": { "type": "boolean" },
        "banReason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "WikiCollection": {
      "title": "WikiCollection",
      "description": "Coleções e tópicos temáticos da enciclopédia",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "titulo": { "type": "string" },
        "descricao": { "type": "string" },
        "categoria": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["uid", "titulo"]
    },
    "WikiArticle": {
      "title": "WikiArticle",
      "description": "Artigos em formato wikitext e metadados",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pageUid": { "type": "string" },
        "titulo": { "type": "string" },
        "descricao": { "type": "string" },
        "autor": { "type": "string" },
        "categoria": { "type": "string" }
      },
      "required": ["id", "pageUid", "titulo"]
    },
    "Page": {
      "title": "Page",
      "description": "Páginas do WikiZero organizadas por Namespaces (main, talk, user, template, etc.) e Categorias",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "namespace": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "categories": { "type": "array" },
        "templateName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "version": { "type": "number" }
      },
      "required": ["id", "namespace", "title", "content"]
    },
    "Template": {
      "title": "Template",
      "description": "Predefinições de conteúdo com suporte a substituição de parâmetros {{{param}}}",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "content": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Documentos de usuários e permissões"
    },
    "/documentos/{pageUid}": {
      "schema": "WikiCollection",
      "description": "Coleções de tópicos"
    },
    "/documentos/{pageUid}/inevitavel/{articleId}": {
      "schema": "WikiArticle",
      "description": "Artigos da enciclopédia"
    },
    "/pages/{pageId}": {
      "schema": "Page",
      "description": "Páginas da enciclopédia organizadas por namespaces e categorias"
    },
    "/templates/{templateId}": {
      "schema": "Template",
      "description": "Predefinições e modelos de conteúdo para renderização dinâmica"
    },
    "/banned_users/{userId}": {
      "schema": "UserProfile",
      "description": "Lista de usuários banidos"
    },
    "/audit_logs/{logId}": {
      "schema": "object",
      "description": "Registros de auditoria administrativa"
    }
  }
}
