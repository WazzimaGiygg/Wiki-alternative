rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de autenticação e RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'pedrohenriquecardonaperes@gmail.com';
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (userDocExists() && (
          getUserData().group == 'admin' ||
          getUserData().role == 'admin'
        ))
      );
    }
    
    function isEditor() {
      return isAuthenticated() && (
        isAdmin() ||
        (userDocExists() && (
          getUserData().group in ['editor', 'admin'] ||
          getUserData().role in ['editor', 'moderador', 'admin']
        ))
      );
    }
    
    function isRegistered() {
      return isAuthenticated();
    }
    
    function isUserInGroup(allowedGroups) {
      return isAuthenticated() && (
        isAdmin() ||
        (userDocExists() && (
          getUserData().group in allowedGroups ||
          getUserData().role in allowedGroups
        )) ||
        // Usuário registrado padrão
        ('registered' in allowedGroups && isAuthenticated())
      );
    }

    // Coleções de tópicos e artigos legados da Wiki
    match /documentos/{pageUid} {
      allow read: if true;
      allow write: if isRegistered();
      
      match /inevitavel/{articleId} {
        allow read: if true;
        allow create: if isRegistered();
        allow update: if isUserInGroup(['registered', 'editor', 'admin']);
        allow delete: if isAdmin();
      }
    }

    // Coleção de Páginas com Namespaces e Categorias
    match /pages/{pageId} {
      allow read: if true;
      // Criação permitida para qualquer usuário registrado
      allow create: if isRegistered() && request.resource.data.title is string && request.resource.data.namespace is string;
      // Edição permitida para 'registered', 'editor' e 'admin'
      allow update: if isUserInGroup(['registered', 'editor', 'admin']);
      // Exclusão restrita estritamente a 'admin'
      allow delete: if isAdmin();

      // Subcoleção de Histórico de Versões (Revisões do Artigo)
      match /versions/{versionId} {
        allow read: if true;
        allow create: if isRegistered() && request.resource.data.versionNumber is number;
        allow update: if isEditor();
        allow delete: if isAdmin();
      }
    }

    // Coleção de Predefinições / Templates (requer grupo 'editor' ou 'admin')
    match /templates/{templateId} {
      allow read: if true;
      allow create: if isEditor() && request.resource.data.name is string && request.resource.data.content is string;
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // Coleção de Páginas de Usuários (Userpage)
    match /userpage/{userId} {
      allow get: if true;
      allow list: if isSignedIn() || true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Perfis de usuários
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Lista de banimentos (gestão por editores e administradores)
    match /banned_users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    // Logs de auditoria administrativa
    match /audit_logs/{logId} {
      allow read: if isEditor();
      allow create: if isEditor();
      allow update, delete: if isAdmin();
    }

    // Coleção de Lista de Vigilância (Watchlist)
    match /watchlist/{itemId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Regra fallback
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

