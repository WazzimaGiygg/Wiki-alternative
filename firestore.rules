rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNÇÕES AUXILIARES
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNotBanned() {
      return isAuthenticated() && 
        !exists(/databases/$(database)/documents/banned_users/$(request.auth.uid));
    }

    // ✅ CORRIGIDO: Agora verifica banimento
    function isRegistered() {
      return isAuthenticated() && isNotBanned();
    }

    function isOwner(userId) {
      return isAuthenticated() && isNotBanned() && request.auth.uid == userId;
    }
    
    function userDocExists() {
      return isRegistered() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'pedrohenriquecardonaperes@gmail.com';
    }
    
    function isAdmin() {
      return isAuthenticated() && isNotBanned() && (
        isSuperAdmin() ||
        (userDocExists() && (
          getUserData().group == 'admin' ||
          getUserData().role == 'admin'
        ))
      );
    }
    
    function isEditor() {
      return isRegistered() && (
        isAdmin() ||
        (userDocExists() && (
          getUserData().group in ['editor', 'admin'] ||
          getUserData().role in ['editor', 'moderador', 'admin']
        ))
      );
    }
    
    function isUserInGroup(allowedGroups) {
      return isRegistered() && (
        isAdmin() ||
        (userDocExists() && (
          getUserData().group in allowedGroups ||
          getUserData().role in allowedGroups
        )) ||
        ('registered' in allowedGroups && isRegistered())
      );
    }

    // ==========================================
    // COLEÇÕES
    // ==========================================

    // Coleção de artigos (versão legada)
    match /documentos/{pageUid} {
      allow read: if true;
      allow write: if isRegistered();
      
      match /inevitavel/{articleId} {
        allow read: if true;
        allow create: if isRegistered();
        allow update: if isUserInGroup(['registered', 'editor', 'admin']);
        allow delete: if isAdmin();
      }
    }

    // Coleção principal de páginas ✅ CORRIGIDO
    match /pages/{pageId} {
      allow read: if true;
      // ✅ AGORA permite criar sem namespace obrigatório
      allow create: if isRegistered() && request.resource.data.title is string;
      allow update: if isUserInGroup(['registered', 'editor', 'admin']);
      allow delete: if isAdmin();

      match /versions/{versionId} {
        allow read: if true;
        allow create: if isRegistered() && request.resource.data.versionNumber is number;
        allow update: if isEditor();
        allow delete: if isAdmin();
      }
    }

    match /templates/{templateId} {
      allow read: if true;
      allow create: if isEditor() && request.resource.data.name is string && request.resource.data.content is string;
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // Páginas de usuário
    match /userpage/{userId} {
      allow read: if true;
      allow create, update: if isRegistered() && (isOwner(userId) || isAdmin());
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Perfis de usuários
    match /users/{userId} {
      allow read: if true;
      allow create: if isRegistered() && request.auth.uid == userId;
      allow update: if isRegistered() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Lista de banimentos ✅ CORRIGIDO: apenas admins podem gerenciar
    match /banned_users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Apenas admins podem banir/desbanir
    }

    match /audit_logs/{logId} {
      allow read: if isEditor();
      allow create: if isEditor();
      allow update, delete: if isAdmin();
    }

    match /watchlist/{itemId} {
      allow read: if isRegistered() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isRegistered() && request.resource.data.userId == request.auth.uid;
      allow update: if isRegistered() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isRegistered() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Regra fallback
    match /{document=**} {
      allow read: if true;
      allow write: if isRegistered();
    }
  }
}