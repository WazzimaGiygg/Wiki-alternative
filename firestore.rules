rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // FUNÇÕES AUXILIARES DE AUTORIZAÇÃO E SEGURANÇA
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNotBanned() {
      return isAuthenticated() && 
        !exists(/databases/$(database)/documents/banned_users/$(request.auth.uid));
    }

    function isRegistered() {
      return isAuthenticated() && isNotBanned();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function userDocExists() {
      return exists(/databases/$(database)/documents/userpage/$(request.auth.uid)) ||
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return exists(/databases/$(database)/documents/userpage/$(request.auth.uid))
        ? get(/databases/$(database)/documents/userpage/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Proteção de Superadministrador: Prioriza Custom Claims e e-mail legítimo verificado
    function isSuperAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token &&
         request.auth.token.email == 'pedrohenriquecardonaperes@gmail.com' &&
         (!('email_verified' in request.auth.token) || request.auth.token.email_verified == true)) ||
        ('superadmin' in request.auth.token && request.auth.token.superadmin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'superadmin') ||
        exists(/databases/$(database)/documents/superadmins/$(request.auth.uid))
      );
    }
    
    // Proteção de Administrador: Custom Claims, lista autoritativa ou registro validado
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role in ['admin', 'administrador', 'superadmin']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (userDocExists() && (
          getUserData().group in ['admin', 'administrador', 'superadmin'] ||
          getUserData().role in ['admin', 'administrador', 'superadmin']
        ))
      );
    }

    // Membro de CheckUser: logs e investigações de IP/contas múltiplas
    function isCheckUser() {
      return isAuthenticated() && (
        isAdmin() ||
        ('checkuser' in request.auth.token && request.auth.token.checkuser == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'checkuser') ||
        (userDocExists() && (
          getUserData().group in ['checkuser', 'admin', 'administrador', 'superadmin'] ||
          getUserData().role in ['checkuser', 'admin', 'administrador', 'superadmin']
        ))
      );
    }

    // Membro do Conselho de Arbitragem (ArbCom)
    function isArbCom() {
      return isAuthenticated() && (
        isAdmin() ||
        ('arbcom' in request.auth.token && request.auth.token.arbcom == true) ||
        ('role' in request.auth.token && request.auth.token.role in ['arbcom', 'arbitrador']) ||
        exists(/databases/$(database)/documents/arbitration_members/$(request.auth.uid)) ||
        (userDocExists() && (
          getUserData().group in ['arbcom', 'arbitrador', 'admin', 'administrador', 'superadmin'] ||
          getUserData().role in ['arbcom', 'arbitrador', 'admin', 'administrador', 'superadmin']
        ))
      );
    }
    
    function isEditor() {
      return isRegistered() && (
        isAdmin() ||
        ('editor' in request.auth.token && request.auth.token.editor == true) ||
        ('role' in request.auth.token && request.auth.token.role in ['editor', 'moderador', 'admin', 'administrador']) ||
        (userDocExists() && (
          getUserData().group in ['editor', 'admin', 'moderador', 'administrador'] ||
          getUserData().role in ['editor', 'moderador', 'admin', 'administrador']
        ))
      );
    }
    
    function isUserInGroup(allowedGroups) {
      return isRegistered() && (
        isAdmin() ||
        (userDocExists() && (
          getUserData().group in allowedGroups ||
          getUserData().role in allowedGroups
        )) ||
        ('registered' in allowedGroups && isRegistered())
      );
    }

    // Usuário autorizado a editar (autenticado, não banido e sem canEdit revogado)
    function canUserEdit() {
      return isRegistered() && (
        !userDocExists() || (
          (!('isBanned' in getUserData()) || getUserData().isBanned != true) &&
          (!('permissions' in getUserData()) || !('canEdit' in getUserData().permissions) || getUserData().permissions.canEdit != false)
        )
      );
    }

    function isModeratorOrAdmin() {
      return isAuthenticated() && (
        isAdmin() ||
        (userDocExists() && (
          getUserData().group in ['admin', 'administrador', 'superadmin', 'moderador', 'moderator'] ||
          getUserData().role in ['admin', 'administrador', 'superadmin', 'moderador', 'moderator']
        ))
      );
    }

    // =========================================================================
    // COLEÇÃO PRINCIPAL: PÁGINAS E ARTIGOS (LEITURA PÚBLICA, ESCRITA PROTEGIDA)
    // =========================================================================

    // ✅ Coleção de páginas
    match /pages/{pageId} {
      allow read: if true;
      allow create: if canUserEdit() && (
        isModeratorOrAdmin() || (
          (!('namespace' in request.resource.data) || (request.resource.data.namespace != 'special' && request.resource.data.namespace != 'mediawiki')) &&
          (!('isLocked' in request.resource.data) || request.resource.data.isLocked != true)
        )
      );
      allow update: if canUserEdit() && (
        isModeratorOrAdmin() || (
          (!('namespace' in resource.data) || (resource.data.namespace != 'special' && resource.data.namespace != 'mediawiki')) &&
          (!('isLocked' in resource.data) || resource.data.isLocked != true) &&
          (!('isLocked' in request.resource.data) || request.resource.data.isLocked == resource.data.isLocked)
        )
      );
      allow delete: if isAdmin();

      match /versions/{versionId} {
        allow read: if true;
        allow create: if canUserEdit() && (
          isModeratorOrAdmin() ||
          !exists(/databases/$(database)/documents/pages/$(pageId)) ||
          (!('isLocked' in get(/databases/$(database)/documents/pages/$(pageId)).data) || get(/databases/$(database)/documents/pages/$(pageId)).data.isLocked != true)
        );
        allow update, delete: if isAdmin();
      }
    }

    // ✅ Coleção principal de artigos WikiZero
    match /articles/{articleId} {
      allow read: if true;
      allow create: if canUserEdit() && (
        isModeratorOrAdmin() || (!('isLocked' in request.resource.data) || request.resource.data.isLocked != true)
      );
      allow update: if canUserEdit() && (
        isModeratorOrAdmin() || (
          (!('isLocked' in resource.data) || resource.data.isLocked != true) &&
          (!('protectionLevel' in resource.data) || resource.data.protectionLevel != 'moderators_only') &&
          (!('isLocked' in request.resource.data) || request.resource.data.isLocked == false) &&
          (!('protectionLevel' in request.resource.data) || request.resource.data.protectionLevel == null)
        )
      );
      allow delete: if isAdmin();
    }

    // ✅ Coleção de documentos e tópicos temáticos
    match /documentos/{pageUid} {
      allow read: if true;
      allow create, update: if canUserEdit() && (
        isModeratorOrAdmin() || (
          (!('isLocked' in resource.data) || resource.data.isLocked != true) &&
          (!('isLocked' in request.resource.data) || request.resource.data.isLocked == false)
        )
      );
      allow delete: if isAdmin();
      
      match /inevitavel/{articleId} {
        allow read: if true;
        allow create: if canUserEdit() && (
          isModeratorOrAdmin() || (!('isLocked' in request.resource.data) || request.resource.data.isLocked != true)
        );
        allow update: if canUserEdit() && (
          isModeratorOrAdmin() || (
            (!('isLocked' in resource.data) || resource.data.isLocked != true) &&
            (!('protectionLevel' in resource.data) || resource.data.protectionLevel != 'moderators_only') &&
            (!('isLocked' in request.resource.data) || request.resource.data.isLocked == false) &&
            (!('protectionLevel' in request.resource.data) || request.resource.data.protectionLevel == null)
          )
        );
        allow delete: if isAdmin();
      }
    }

    // ✅ Templates - leitura pública, edição restrita a editores
    match /templates/{templateId} {
      allow read: if true;
      allow create: if isEditor() && request.resource.data.name is string && request.resource.data.content is string;
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 1. PROTEÇÃO DE USUÁRIOS E PERFIS (users & userpage)
    // =========================================================================

    // ✅ Páginas de perfil de usuário - leitura pública, escrita estritamente protegida
    match /userpage/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isOwner(userId) && isNotBanned() &&
        // Bloqueia autoatribuição de privilégios e papéis administrativos
        (!('role' in request.resource.data) || request.resource.data.role in ['leitor', 'editor', 'registrado', 'leitor_ativo', 'convidado']) &&
        (!('group' in request.resource.data) || request.resource.data.group in ['registered', 'leitor', 'editor', 'registrado']) &&
        // Bloqueia permissões de exclusão, travamento ou administrativas
        (!('permissions' in request.resource.data) || (
          (!('canDelete' in request.resource.data.permissions) || request.resource.data.permissions.canDelete == false) &&
          (!('canLock' in request.resource.data.permissions) || request.resource.data.permissions.canLock == false) &&
          (!('isAdmin' in request.resource.data.permissions) || request.resource.data.permissions.isAdmin == false)
        )) &&
        // Bloqueia personificação e alteração de UID
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('id' in request.resource.data) || request.resource.data.id == userId) &&
        // Usuário comum não pode auto-desbloquear
        (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false)
      );

      allow update: if isAdmin() || (
        isOwner(userId) && isNotBanned() &&
        // Impede que usuário comum modifique 'role'
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        // Impede que usuário comum modifique 'group'
        (!('group' in request.resource.data) || request.resource.data.group == resource.data.group) &&
        // Impede alteração não autorizada de permissões especiais
        (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions) &&
        // Impede que usuário comum altere estado de banimento
        (!('isBanned' in request.resource.data) || request.resource.data.isBanned == resource.data.isBanned) &&
        // Impede modificação de identificadores de conta
        (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid) &&
        (!('id' in request.resource.data) || request.resource.data.id == resource.data.id)
      );

      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ✅ Coleção users - dados de conta e configurações do usuário
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isOwner(userId) && isNotBanned() &&
        (!('role' in request.resource.data) || request.resource.data.role in ['leitor', 'editor', 'registrado', 'leitor_ativo', 'convidado']) &&
        (!('group' in request.resource.data) || request.resource.data.group in ['registered', 'leitor', 'editor', 'registrado']) &&
        (!('permissions' in request.resource.data) || (
          (!('canDelete' in request.resource.data.permissions) || request.resource.data.permissions.canDelete == false) &&
          (!('canLock' in request.resource.data.permissions) || request.resource.data.permissions.canLock == false) &&
          (!('isAdmin' in request.resource.data.permissions) || request.resource.data.permissions.isAdmin == false)
        )) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('id' in request.resource.data) || request.resource.data.id == userId) &&
        (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false)
      );

      allow update: if isAdmin() || (
        isOwner(userId) && isNotBanned() &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('group' in request.resource.data) || request.resource.data.group == resource.data.group) &&
        (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions) &&
        (!('isBanned' in request.resource.data) || request.resource.data.isBanned == resource.data.isBanned) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid) &&
        (!('id' in request.resource.data) || request.resource.data.id == resource.data.id)
      );

      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 2. COLEÇÕES DE PRIVILÉGIOS ADMINISTRATIVOS DO SISTEMA
    // =========================================================================

    // ✅ Lista autoritativa de administradores protegidos
    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ✅ Lista autoritativa de superadministradores
    match /superadmins/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ✅ Lista de banimentos do sistema
    match /banned_users/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ✅ Logs de auditoria - leitura exclusiva de administradores
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isNotBanned();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 3. COLEÇÕES ADMINISTRATIVAS E INVESTIGAÇÕES
    // =========================================================================

    // ✅ Investigações e registros de CheckUser
    match /checkuser_logs/{logId} {
      allow read: if isCheckUser();
      allow create: if isCheckUser();
      allow update, delete: if isAdmin();
    }
    match /checkuser_accounts/{accountId} {
      allow read, write: if isCheckUser();
    }

    // ✅ Casos de sockpuppet
    match /sockpuppet_cases/{caseId} {
      allow get: if isCheckUser() || (isAuthenticated() && resource.data.reporterUid == request.auth.uid);
      allow list: if isCheckUser();
      allow create: if isAuthenticated() && isNotBanned() && (!('reporterUid' in request.resource.data) || request.resource.data.reporterUid == request.auth.uid);
      allow update, delete: if isCheckUser();
    }

    // ✅ Registros de rate-limit e limitação de chamados por IP
    match /emergency_ip_records/{ipRecordId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ✅ Chamados e notificações de contato de emergência
    match /emergency_reports/{reportId} {
      allow get: if isAdmin() || (isAuthenticated() && resource.data.reporterUid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if (request.auth == null || isNotBanned());
      allow update, delete: if isAdmin();
    }

    // ✅ Denúncias Formais do Universal Code of Conduct (UCoC)
    match /ucoc_reports/{reportId} {
      allow get: if isAdmin() || (isAuthenticated() && resource.data.reporterUid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if (request.auth == null || isNotBanned());
      allow update, delete: if isAdmin();
    }

    // ✅ Casos e membros do Conselho de Arbitragem (ArbCom)
    match /arbitration_cases/{caseId} {
      allow read: if true; // Registros públicos para a comunidade
      allow create: if isAuthenticated() && isNotBanned();
      allow update, delete: if isArbCom();
    }
    match /arbitration_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. PROTEÇÃO DAS EXTENSÕES E TELEMETRIA
    // =========================================================================

    // ✅ Definição de extensões do sistema - leitura pública, escrita administrativa
    match /wiki_extensions/{extensionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ✅ Registro de estados ativos das extensões - leitura pública, escrita administrativa
    match /wiki_extension_registry/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ✅ Logs de extensões do sistema
    match /wiki_extension_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isNotBanned();
      allow update, delete: if isAdmin();
    }

    // ✅ Telemetria do sistema
    match /system_telemetry/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. SOLICITAÇÕES, PEDIDOS E DENÚNCIAS
    // =========================================================================

    // ✅ Pedidos de desbloqueio de contas (Qualquer usuário bloqueado ou anônimo pode recorrer)
    match /unblock_requests/{requestId} {
      allow get: if isAdmin() || (isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
      allow list: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ✅ Pedidos de promoção (RfA) - leitura pública comunitária
    match /promotion_requests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBanned() && (
        !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ✅ Central de ajuda e tickets da administração
    match /admin_tickets/{ticketId} {
      allow get: if isAdmin() || (isAuthenticated() && (
        resource.data.userUid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
      allow list: if isAdmin() || (isAuthenticated() && (
        resource.data.userUid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
      allow create: if (request.auth == null || isNotBanned());
      allow update: if isAdmin() || (isAuthenticated() && (
        resource.data.userUid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 6. COMUNICAÇÃO, NOTIFICAÇÕES E COLABORAÇÃO
    // =========================================================================

    // ✅ Mensagens em páginas de discussão de usuários (públicas)
    match /user_talk_messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBanned() && (
        !('senderUid' in request.resource.data) ||
        request.resource.data.senderUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && isNotBanned() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.targetUserUid == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostas', 'status'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.targetUserUid == request.auth.uid
      ));
    }

    // ✅ Notificações do sistema - apenas destinatário ou administrador
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && isNotBanned();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ✅ Notas de versão e atualizações do sistema
    match /system_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ✅ Watchlist do usuário - estritamente privada
    match /watchlist/{itemId} {
      allow read: if isRegistered() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isRegistered() && request.resource.data.userId == request.auth.uid;
      allow update: if isRegistered() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isRegistered() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ✅ Discussões e tópicos comunitários - criação vinculada ao autor, alteração restrita ao autor da thread ou admin
    match /talk_threads/{threadId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBanned() && (
        !('autorUid' in request.resource.data) ||
        request.resource.data.autorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && isNotBanned() && (
        resource.data.autorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostas'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && (
        resource.data.autorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
    }

    // ✅ Avaliações comunitárias de artigos - criação/atualização de votos aberta, deleção apenas por administradores
    match /ratings/{articleId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isNotBanned();
      allow delete: if isAdmin();
    }

    // ✅ Gemini Notebooks - pesquisa e notas (privado por proprietário)
    match /gemini_notebooks/{notebookId} {
      allow read: if isRegistered() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isRegistered() && request.resource.data.userId == request.auth.uid;
      allow update: if isRegistered() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isRegistered() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ✅ Mudanças recentes - auditoria transparente: criação vinculada ao autor, alteração/exclusão exclusiva de administradores
    match /recent_changes/{changeId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBanned() && (
        !('autorUid' in request.resource.data) ||
        request.resource.data.autorUid == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ✅ Acervo bibliográfico e resenhas - modificação e exclusão apenas pelo catalogador ou administrador
    match /library_items/{itemId} {
      allow read: if true;
      allow create: if isRegistered() && (
        !('cadastradoPorUid' in request.resource.data) ||
        request.resource.data.cadastradoPorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin() || (isRegistered() && (
        resource.data.cadastradoPorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
    }
    match /library_reviews/{reviewId} {
      allow read: if true;
      allow create: if isRegistered() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isRegistered() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ✅ Repositório Acadêmico e Avaliação por Pares - vinculado ao autor
    match /academic_publications/{pubId} {
      allow read: if true;
      allow create: if isRegistered() && (
        !('submittedByUid' in request.resource.data) ||
        request.resource.data.submittedByUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin() || (isRegistered() && resource.data.submittedByUid == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.submittedByUid == request.auth.uid);
    }
    match /academic_peer_reviews/{reviewId} {
      allow read: if true;
      allow create: if isRegistered() && (
        !('reviewerUid' in request.resource.data) ||
        request.resource.data.reviewerUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin() || (isRegistered() && resource.data.reviewerUid == request.auth.uid);
      allow delete: if isAuthenticated() && (
        resource.data.reviewerUid == request.auth.uid ||
        isAdmin()
      );
    }

    // ✅ Chat direto entre usuários
    match /user_chats/{chatId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isRegistered() && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isRegistered() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/user_chats/$(chatId)).data.participants ||
          isAdmin()
        );
        allow create: if isRegistered() && (
          request.resource.data.senderUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/user_chats/$(chatId)).data.participants
        );
        allow update: if isRegistered() && (
          request.auth.uid in get(/databases/$(database)/documents/user_chats/$(chatId)).data.participants
        );
        allow delete: if isAdmin() || (
          isAuthenticated() && resource.data.senderUid == request.auth.uid
        );
      }
    }

    // ✅ Relatórios de Auditoria Antiplágio
    match /antiplagiarism_reports/{reportId} {
      allow get: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userUid == request.auth.uid ||
        (resource.data.advisorEmail != null && resource.data.advisorEmail != '' && resource.data.advisorEmail == request.auth.token.email) ||
        (resource.data.advisorUid != null && resource.data.advisorUid != '' && resource.data.advisorUid == request.auth.uid)
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userUid == request.auth.uid ||
        (resource.data.advisorEmail != null && resource.data.advisorEmail != '' && resource.data.advisorEmail == request.auth.token.email) ||
        (resource.data.advisorUid != null && resource.data.advisorUid != '' && resource.data.advisorUid == request.auth.uid)
      );
      allow create: if isAuthenticated() && isNotBanned() && (
        request.resource.data.userUid == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && isNotBanned() && (
        resource.data.userUid == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && isNotBanned() && (
        resource.data.userUid == request.auth.uid || isAdmin()
      );
    }

    // ✅ Limites diários de edição
    match /user_daily_edits/{docId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow write: if canUserEdit() && request.resource.data.uid == request.auth.uid;
    }

    // =========================================================================
    // FALLBACK DE SEGURANÇA: DEFAULT DENY TOTAL
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}